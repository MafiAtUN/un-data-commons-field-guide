---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A lesson's still. Served by this site in AVIF or WebP, sized to where it
 * sits, so a page full of cards costs a few hundred kilobytes and nothing is
 * requested from YouTube.
 */
interface Props {
  src: ImageMetadata;
  sizes: string;
  eager?: boolean;
  /** Ask for it before other images: only the largest image on first screen. */
  priority?: boolean;
  class?: string;
}
const { src, sizes, eager = false, priority = eager, class: className = '' } = Astro.props;
---
<Picture
  src={src}
  formats={['avif', 'webp']}
  widths={[160, 320, 480, 720, 960, 1280]}
  sizes={sizes}
  alt=""
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={`block aspect-video w-full object-cover ${className}`}
/>
