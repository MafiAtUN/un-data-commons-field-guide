{
  "name": "un-data-commons-field-guide",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Short video lessons for the UN System Data Commons (data.un.org) and the undata Python package.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:site": "vitest run --config vitest.site.config.ts",
    "snapshots": "node scripts/fetch-snapshots.mjs",
    "countries": "node scripts/fetch-countries.mjs",
    "posters": "node scripts/posters.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:site"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "astro": "^7.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
